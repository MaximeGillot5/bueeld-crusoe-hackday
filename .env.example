# Copy to .env for local use. The server never sends this key to the browser.
CRUSOE_API_KEY=
CRUSOE_MODEL=deepseek-ai/DeepSeek-V4-Flash
HOST=127.0.0.1
PORT=4173
LAB_DATA_DIR=./.data
MAX_AI_CALLS=100
MAX_AI_CALLS_PER_USER=20
MAX_GITHUB_FETCHES=20
# Set only when the public HTTPS origin is known, with no trailing slash.
# LAB_PUBLIC_ORIGIN=https://your-service.onrender.com
