# Copy to .env for local use. The server never sends this key to the browser.
CRUSOE_API_KEY=
CRUSOE_MODEL=deepseek-ai/Deepseek-V4-Flash
# Optional BAND external review. Register two distinct remote agents in the same
# Band account and copy each agent UUID and API key from its Band dashboard.
# These keys stay on the server. The Band room is visible to their human owner.
BAND_SCOUT_AGENT_ID=
BAND_SCOUT_API_KEY=
BAND_CRITIC_AGENT_ID=
BAND_CRITIC_API_KEY=
# Optional credit-exhaustion fallback: AdaL must be installed and signed in locally.
# ADAL_BIN=adal
# ADAL_MODEL=
# Optional local-only preview when no Crusoe key is configured. Requires HOST=127.0.0.1 or localhost.
# ADAL_IF_CRUSOE_UNCONFIGURED=1
HOST=127.0.0.1
PORT=4173
LAB_DATA_DIR=./.data
MAX_AI_CALLS=100
MAX_AI_CALLS_PER_USER=20
MAX_GITHUB_FETCHES=20
# Set only when the public HTTPS origin is known, with no trailing slash.
# LAB_PUBLIC_ORIGIN=https://your-service.onrender.com
