# Copy to .env for local use. The server never sends this key to the browser.
CRUSOE_API_KEY=
CRUSOE_MODEL=deepseek-ai/DeepSeek-V4-Flash
HOST=127.0.0.1
PORT=4173
LAB_DATA_DIR=./.data
MAX_AI_CALLS=100
MAX_AI_CALLS_PER_USER=20
MAX_GITHUB_FETCHES=20
# Set only when the public HTTPS origin is known, with no trailing slash.
# LAB_PUBLIC_ORIGIN=https://your-service.onrender.com

# Plaud Embedded: create an app and API key at https://portal.plaud.ai.
# Keep these values on the server. The iPhone bridge gets its Plaud user token by pairing.
PLAUD_CLIENT_ID=
PLAUD_CLIENT_SECRET=
PLAUD_API_KEY=
# Add a comma-separated exact host only if Plaud returns a different signed DownloadUrl host.
# PLAUD_DOWNLOAD_HOSTS=plaud-bucket.s3.us-west-2.amazonaws.com
