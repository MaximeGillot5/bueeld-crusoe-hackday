diff --git a/ios/PlaudTemplateApp/Managers/BUEELDImportClient.swift b/ios/PlaudTemplateApp/Managers/BUEELDImportClient.swift
new file mode 100644
index 0000000..c542568
--- /dev/null
+++ b/ios/PlaudTemplateApp/Managers/BUEELDImportClient.swift
@@ -0,0 +1,205 @@
+import CryptoKit
+import Foundation
+import Security
+
+/// Connects this temporary Plaud companion to the BUEELD website. The BUEELD
+/// server starts and owns the Plaud transcription task before storing its result.
+enum BUEELDImportClient {
+    private static let siteURLKey = "BUEELDSiteURL"
+    private static let submittedPrefix = "BUEELDSubmitted."
+    private static let keychainService = "com.bueeld.plaud-companion"
+
+    static var siteURL: String {
+        get { UserDefaults.standard.string(forKey: siteURLKey) ?? "" }
+        set { UserDefaults.standard.set(newValue, forKey: siteURLKey) }
+    }
+
+    static var userAccessToken: String? { keychainValue(for: "user-access-token") }
+    static var ingestToken: String? { keychainValue(for: "ingest-token") }
+
+    static func hasSubmitted(_ file: RecordingFile) -> Bool {
+        UserDefaults.standard.bool(forKey: submittedPrefix + file.id)
+    }
+
+    static func markSubmitted(_ file: RecordingFile) {
+        UserDefaults.standard.set(true, forKey: submittedPrefix + file.id)
+    }
+
+    enum ImportError: LocalizedError {
+        case invalidURL
+        case missingCode
+        case notPaired
+        case accountMismatch
+        case invalidServerResponse
+        case http(Int, String)
+        case keychain(OSStatus)
+
+        var errorDescription: String? {
+            switch self {
+            case .invalidURL: return "Enter the HTTPS URL of the BUEELD site."
+            case .missingCode: return "Enter the pairing code shown on BUEELD."
+            case .notPaired: return "Pair this app with BUEELD first."
+            case .accountMismatch: return "This device is bound to a different Plaud user. Unpair it before connecting another BUEELD project."
+            case .invalidServerResponse: return "BUEELD returned an invalid response."
+            case .http(let status, let message): return "BUEELD error \(status): \(message)"
+            case .keychain: return "Could not save the pairing tokens on this iPhone."
+            }
+        }
+    }
+
+    private struct ExchangeRequest: Encodable { let code: String }
+    private struct ExchangeResponse: Decodable {
+        let userAccessToken: String
+        let ingestToken: String
+    }
+
+    private struct IngestRequest: Encodable {
+        let fileUrl: String
+        let title: String
+        let recordedAt: String
+        let externalId: String
+    }
+
+    static func exchangePairingCode(
+        _ code: String,
+        at inputURL: String,
+        completion: @escaping (Result<Void, Error>) -> Void
+    ) {
+        let code = code.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !code.isEmpty else { completion(.failure(ImportError.missingCode)); return }
+        guard let endpoint = endpoint(from: inputURL, path: "/api/plaud/pairings/exchange") else {
+            completion(.failure(ImportError.invalidURL))
+            return
+        }
+        var request = URLRequest(url: endpoint)
+        request.httpMethod = "POST"
+        request.timeoutInterval = 30
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        do { request.httpBody = try JSONEncoder().encode(ExchangeRequest(code: code)) }
+        catch { completion(.failure(error)); return }
+
+        URLSession.shared.dataTask(with: request) { data, response, error in
+            switch validatedData(data, response, error) {
+            case .failure(let error): completion(.failure(error))
+            case .success(let data):
+                guard let tokens = try? JSONDecoder().decode(ExchangeResponse.self, from: data),
+                      let newUser = JwtUtils.parse(tokens.userAccessToken),
+                      !tokens.ingestToken.isEmpty else {
+                    completion(.failure(ImportError.invalidServerResponse))
+                    return
+                }
+                if !RecordingStore.shared.pairedDeviceSNs.isEmpty,
+                   let boundUserId = RecordingStore.shared.userId,
+                   boundUserId != newUser.sub {
+                    completion(.failure(ImportError.accountMismatch))
+                    return
+                }
+                do {
+                    try saveKeychainValue(tokens.userAccessToken, for: "user-access-token")
+                    try saveKeychainValue(tokens.ingestToken, for: "ingest-token")
+                    siteURL = inputURL.trimmingCharacters(in: .whitespacesAndNewlines)
+                    // The starter also supports a manual token override. Remove any
+                    // stale override so this paired user's token takes precedence.
+                    UserDefaults.standard.removeObject(forKey: "userAccessTokenOverride")
+                    completion(.success(()))
+                } catch { completion(.failure(error)) }
+            }
+        }.resume()
+    }
+
+    static func submitUploadedRecording(
+        fileURL: String,
+        file: RecordingFile,
+        completion: @escaping (Result<Void, Error>) -> Void
+    ) {
+        guard let token = ingestToken, !token.isEmpty else {
+            completion(.failure(ImportError.notPaired))
+            return
+        }
+        guard let endpoint = endpoint(from: siteURL, path: "/api/plaud/transcriptions") else {
+            completion(.failure(ImportError.invalidURL))
+            return
+        }
+
+        // Use the serial only locally to compute a stable duplicate key. The serial
+        // itself, audio, and transcript never leave the phone for BUEELD.
+        let digest = SHA256.hash(data: Data("\(file.deviceSN):\(file.sessionId)".utf8))
+        let externalId = digest.map { String(format: "%02x", $0) }.joined()
+        let formatter = ISO8601DateFormatter()
+        formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+
+        var request = URLRequest(url: endpoint)
+        request.httpMethod = "POST"
+        request.timeoutInterval = 30
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization")
+        do {
+            request.httpBody = try JSONEncoder().encode(IngestRequest(
+                fileUrl: fileURL,
+                title: file.name,
+                recordedAt: formatter.string(from: file.createdAt),
+                externalId: externalId
+            ))
+        } catch { completion(.failure(error)); return }
+
+        URLSession.shared.dataTask(with: request) { data, response, error in
+            switch validatedData(data, response, error) {
+            case .success: completion(.success(()))
+            case .failure(let error): completion(.failure(error))
+            }
+        }.resume()
+    }
+
+    private static func endpoint(from input: String, path: String) -> URL? {
+        let trimmed = input.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard var parts = URLComponents(string: trimmed),
+              parts.scheme?.lowercased() == "https",
+              parts.host != nil,
+              parts.user == nil, parts.password == nil,
+              parts.query == nil, parts.fragment == nil else { return nil }
+        parts.path = path
+        return parts.url
+    }
+
+    private static func validatedData(
+        _ data: Data?, _ response: URLResponse?, _ error: Error?
+    ) -> Result<Data, Error> {
+        if let error = error { return .failure(error) }
+        guard let http = response as? HTTPURLResponse else {
+            return .failure(ImportError.invalidServerResponse)
+        }
+        guard (200..<300).contains(http.statusCode) else {
+            let body = data.flatMap { String(data: $0, encoding: .utf8) } ?? "Request failed"
+            return .failure(ImportError.http(http.statusCode, String(body.prefix(240))))
+        }
+        return .success(data ?? Data())
+    }
+
+    private static func keychainValue(for account: String) -> String? {
+        let query: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: keychainService,
+            kSecAttrAccount as String: account,
+            kSecReturnData as String: true,
+            kSecMatchLimit as String: kSecMatchLimitOne
+        ]
+        var item: CFTypeRef?
+        guard SecItemCopyMatching(query as CFDictionary, &item) == errSecSuccess,
+              let data = item as? Data else { return nil }
+        return String(data: data, encoding: .utf8)
+    }
+
+    private static func saveKeychainValue(_ value: String, for account: String) throws {
+        let query: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: keychainService,
+            kSecAttrAccount as String: account
+        ]
+        SecItemDelete(query as CFDictionary)
+        var attributes = query
+        attributes[kSecValueData as String] = Data(value.utf8)
+        attributes[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+        let status = SecItemAdd(attributes as CFDictionary, nil)
+        guard status == errSecSuccess else { throw ImportError.keychain(status) }
+    }
+}
